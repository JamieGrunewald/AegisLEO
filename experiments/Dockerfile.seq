FROM nvcr.io/nvidia/pytorch:25.05-py3-igpu

WORKDIR /workspace

COPY . /workspace

RUN apt-get update && apt-get install -y \
    cmake \
    ninja-build \
    build-essential \
    git \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir -r requirements.runtime.txt

# Build and install liboqs from local source
RUN cd /workspace/liboqs && \
    mkdir -p build && \
    cd build && \
    cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr/local .. && \
    ninja && \
    ninja install && \
    ldconfig

ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib64:${LD_LIBRARY_PATH}

# Install Python bindings from local source tree
RUN pip install --no-cache-dir /workspace/third_party/liboqs-python

CMD ["bash"]