FROM nvcr.io/nvidia/pytorch:25.05-py3-igpu

WORKDIR /workspace

COPY . /workspace

# Install only the runtime dependencies needed by the receiver
RUN pip install --no-cache-dir -r requirements.runtime.txt

# Install local liboqs-python bindings from the repo
RUN pip install --no-cache-dir ./third_party/liboqs-python

CMD ["bash"]