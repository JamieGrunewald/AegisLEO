FROM nvcr.io/nvidia/pytorch:25.05-py3-igpu

WORKDIR /workspace

COPY . /workspace

RUN apt-get update && apt-get install -y \
    cmake \
    ninja-build \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir -r requirements.runtime.txt

# Build liboqs
RUN cd /workspace/liboqs && \
    mkdir -p build && \
    cd build && \
    cmake -GNinja .. && \
    ninja && \
    ninja install

# 🔥 Force linker to know about liboqs
RUN echo "/usr/local/lib" >> /etc/ld.so.conf.d/liboqs.conf && \
    echo "/usr/local/lib64" >> /etc/ld.so.conf.d/liboqs.conf && \
    ldconfig

# 🔥 Ensure runtime visibility
ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib64:$LD_LIBRARY_PATH

# Install Python bindings
RUN pip install --no-cache-dir liboqs-python

CMD ["bash"]